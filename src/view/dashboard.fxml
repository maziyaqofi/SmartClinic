<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.DashboardController">

    <left>
        <VBox prefWidth="230.0" spacing="9" style="-fx-background-color: #0F172A; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="SMART CLINIC" />
                <Separator />
                <Button prefWidth="190" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 14px;" text="Dashboard" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Pasien" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Dokter" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Petugas" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Obat" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Pendaftaran" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Pemeriksaan" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Rekam Medis" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Prediksi ML" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Hasil dan Riwayat" />
                <Button prefWidth="190" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px;" text="Laporan Klinik" />
            </children>
        </VBox>
    </left>

    <center>
        <AnchorPane prefHeight="650.0" prefWidth="870.0" style="-fx-background-color: #F1F5F9;">
            <children>
                <Label layoutX="35" layoutY="25" style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Dashboard" />
                <Label layoutX="35" layoutY="65" style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Selamat Datang di Smart Clinic System" />

                <HBox layoutX="35.0" layoutY="110.0" prefHeight="110.0" prefWidth="800.0" spacing="18">
                    <children>
                        <VBox alignment="CENTER" prefHeight="110.0" prefWidth="185.0" style="-fx-background-color: #2563EB; -fx-background-radius: 12; -fx-padding: 15;">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Patients" />
                                <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;" text="245" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="110.0" prefWidth="185.0" style="-fx-background-color: #16A34A; -fx-background-radius: 12; -fx-padding: 15;">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Doctors" />
                                <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;" text="18" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="110.0" prefWidth="185.0" style="-fx-background-color: #EA580C; -fx-background-radius: 12; -fx-padding: 15;">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Medicines" />
                                <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;" text="120" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="110.0" prefWidth="185.0" style="-fx-background-color: #DC2626; -fx-background-radius: 12; -fx-padding: 15;">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Appointments" />
                                <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;" text="34" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox layoutX="35.0" layoutY="255.0" prefHeight="330.0" prefWidth="800.0" spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Data Pasien Terbaru" />
                        <TableView fx:id="patientTable" prefHeight="260.0" prefWidth="760.0">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="100" text="ID" />
                                <TableColumn fx:id="colName" prefWidth="280" text="Nama" />
                                <TableColumn fx:id="colAge" prefWidth="150" text="Umur" />
                                <TableColumn fx:id="colGender" prefWidth="220" text="Gender" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>

</BorderPane>
