<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <children>

        <Label layoutX="230.0" layoutY="80.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="SMART CLINIC" textFill="#0468ff" />

        <TextField fx:id="usernameField" layoutX="180.0" layoutY="160.0" prefWidth="240.0" promptText="Username">
         <cursor>
            <Cursor fx:constant="NONE" />
         </cursor></TextField>

        <PasswordField fx:id="passwordField" layoutX="180.0" layoutY="220.0" onAction="#handleLogin" prefWidth="240.0" promptText="Password" />

        <Button defaultButton="true" layoutX="250.0" layoutY="290.0" onAction="#handleLogin" prefWidth="100.0" text="Login" />

        <Label fx:id="messageLabel" layoutX="210.0" layoutY="340.0" style="-fx-text-fill: red;" text="" />

    </children>

</AnchorPane>
